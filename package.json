{
  "name": "add-call",
  "private": true,
  "version": "0.1.0",
  "description": "Add Call \u2014 a web calling app with peer-to-peer WebRTC voice and video.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "vite-node scripts/generate-icons.ts",
    "android": "npm run build && cap sync android && cap open android",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@supabase/supabase-js": "^2.117.3",
    "livekit-client": "^2.22.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.35.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.1.5",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
