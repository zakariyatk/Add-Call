# Hostinger (LiteSpeed / Apache) settings for call.adddots.com.

# Calls need HTTPS: browsers only allow the camera and microphone on secure sites.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"

  # Built scripts and styles have content hashes in their names, so they can be
  # cached for a year; icons for a day; the page itself is always re-checked so
  # new releases show up straight away.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The service worker must update as soon as a release goes live.
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

Options -Indexes
